# ==========================================
# KREW — Environment Configuration Example
# ==========================================

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# --- DATABASE CONFIGURATION ---
# MongoDB Atlas or local connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/krew_db?retryWrites=true&w=majority

# --- AUTHENTICATION SCAFFOLDING ---
JWT_SECRET=super_secret_krew_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# --- RESERVED FOR LIVE HACKATHON: LLM & AGENT PROVIDER INTEGRATIONS ---
# Gemini API Key for autonomous agent execution (Configurable in Settings)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Secondary model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- RESERVED FOR LIVE HACKATHON: VIDEO & STORAGE PLATFORMS ---
CLOUDINARY_URL=
AWS_S3_BUCKET=
